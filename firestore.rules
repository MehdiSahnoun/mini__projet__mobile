rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isEnseignant() {
      return isAuth() && getUserRole() == 'ENSEIGNANT';
    }

    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && (request.auth.uid == userId || isEnseignant());
    }

    match /etudiants/{etudiantId} {
      allow read: if isAuth();
      allow write: if isAuth() && (request.auth.uid == etudiantId || isEnseignant());
    }

    match /matieres/{matiereId} {
      allow read: if isAuth();
      allow write: if isEnseignant();
    }

    match /notes/{noteId} {
      allow read: if isAuth();
      allow write: if isEnseignant();
    }
  }
}
